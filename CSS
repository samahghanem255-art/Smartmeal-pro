body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f7f6;
}

/* NAVBAR */
.navbar {
  display: flex;
  justify-content: space-between;
  padding: 15px;
  background: linear-gradient(90deg, #27ae60, #2ecc71);
  color: white;
  align-items: center;
}

.lang button {
  margin-left: 8px;
  padding: 6px 10px;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

/* HERO */
.hero {
  text-align: center;
  padding: 40px 20px;
}

.hero-img {
  width: 220px;
  height: 220px;
  border-radius: 50%;
  object-fit: cover;
  margin-top: 15px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

/* CARDS */
.cards {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
  padding: 20px;
}

.card {
  background: white;
  width: 170px;
  padding: 20px;
  border-radius: 15px;
  text-align: center;
  box-shadow: 0 6px 15px rgba(0,0,0,0.1);
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-5px);
}

.card button {
  margin-top: 10px;
  padding: 6px 12px;
  border: none;
  background: #2ecc71;
  color: white;
  border-radius: 5px;
  cursor: pointer;
}
